<?xml version="1.0" encoding="utf-8"?>
<form>
    <fieldset name="general">
        <field name="version" type="text" label="COM_CONTRACTOR_VERSION" readonly="true" class="form-control-plaintext px-2" />

        <field name="currency" type="list" label="COM_CONTRACTOR_CURRENCY" default="EUR">
            <option value="EUR">COM_CONTRACTOR_CURRENCY_EUR</option>
            <option value="USD">COM_CONTRACTOR_CURRENCY_USD</option>
            <option value="JPY">COM_CONTRACTOR_CURRENCY_JPY</option>
            <option value="GBP">COM_CONTRACTOR_CURRENCY_GBP</option>
            <option value="CNY">COM_CONTRACTOR_CURRENCY_CNY</option>
            <option value="CHF">COM_CONTRACTOR_CURRENCY_CHF</option>
            <option value="AUD">COM_CONTRACTOR_CURRENCY_AUD</option>
            <option value="CAD">COM_CONTRACTOR_CURRENCY_CAD</option>
            <option value="HKD">COM_CONTRACTOR_CURRENCY_HKD</option>
            <option value="SGD">COM_CONTRACTOR_CURRENCY_SGD</option>
            <option value="INR">COM_CONTRACTOR_CURRENCY_INR</option>
            <option value="KRW">COM_CONTRACTOR_CURRENCY_KRW</option>
            <option value="SEK">COM_CONTRACTOR_CURRENCY_SEK</option>
            <option value="MXN">COM_CONTRACTOR_CURRENCY_MXN</option>
            <option value="NZD">COM_CONTRACTOR_CURRENCY_NZD</option>
            <option value="NOK">COM_CONTRACTOR_CURRENCY_NOK</option>
            <option value="BRL">COM_CONTRACTOR_CURRENCY_BRL</option>
            <option value="PLN">COM_CONTRACTOR_CURRENCY_PLN</option>
            <option value="DKK">COM_CONTRACTOR_CURRENCY_DKK</option>
            <option value="TRY">COM_CONTRACTOR_CURRENCY_TRY</option>
            <option value="HUF">COM_CONTRACTOR_CURRENCY_HUF</option>
            <option value="CZK">COM_CONTRACTOR_CURRENCY_CZK</option>
            <option value="RON">COM_CONTRACTOR_CURRENCY_RON</option>
            <option value="UAH">COM_CONTRACTOR_CURRENCY_UAH</option>
            <option value="BGN">COM_CONTRACTOR_CURRENCY_BGN</option>
        </field>
        <field name="warn_days" type="number" label="COM_CONTRACTOR_WARNDAYS" default="30" min="1" step="1" class="validate-numeric" filter="UINT" validate="number" required="true" />

        <field name="warn_mail" type="text" label="COM_CONTRACTOR_WARNMAIL" default="info@test.com" validate="email" required="true" />
        <field name="warn_when" type="list" label="COM_CONTRACTOR_WARNWHEN" default="9">
            <option value="0">COM_CONTRACTOR_DELAY_NEVER</option>
            <option value="1">COM_CONTRACTOR_DELAY_1</option>
            <option value="2">COM_CONTRACTOR_DELAY_2</option>
            <option value="5">COM_CONTRACTOR_DELAY_5</option>
            <option value="7">COM_CONTRACTOR_DELAY_7</option>
            <option value="9">COM_CONTRACTOR_DELAY_ONCE</option>
        </field>
        <field name="warn_note" type="note" class="alert alert-info my-2 w-100" label="COM_CONTRACTOR_WD_TITLE" description="COM_CONTRACTOR_WD_DESC" />
        <field name="warn_man_note" type="note" class="alert alert-info my-2 w-100" label="" description="COM_CONTRACTOR_WMAN_DESC" />

    </fieldset>
    
    <fieldset name="messaging">
        <field name="mailfrom" type="text" label="COM_CONTRACTOR_MAILFROM" default="info@test.com" validate="email" required="true" />
        <field name="mailfromname" type="text" label="COM_CONTRACTOR_MAILFROMNN" default="" />
        <field name="mailreply" type="text" label="COM_CONTRACTOR_MAILREPL" default="" validate="email" />
        <field name="mailsubject" type="text" label="COM_CONTRACTOR_MAILSUBJ" default="COM_CONTRACTOR_MAILSUBJDEF" required="true" translate_default="true" />
        <field name="mailengine" type="list" label="COM_CONTRACTOR_MAILSENDW" default="0">
            <option value="0">COM_CONTRACTOR_MAILOPTION_JOOMLA</option>
            <option value="1">COM_CONTRACTOR_MAILOPTION_SENDMAIL</option>
            <option value="2">COM_CONTRACTOR_MAILOPTION_SMTP</option>
        </field>

        <field name="smtp_warning" type="note" class="alert alert-warning mt-2 mb-3" label="COM_CONTRACTOR_SMTP_WARNING_TITLE" description="COM_CONTRACTOR_SMTP_WARNING_DESC" showon="mailengine:2" />

        <field name="smtp_host" type="text" label="COM_CONTRACTOR_SMTP_HOST" default="localhost" showon="mailengine:2" />
        
        <field name="smtp_port" type="number" label="COM_CONTRACTOR_SMTP_PORT" default="25" filter="UINT" showon="mailengine:2" />
        
        <field name="smtp_security" type="list" label="COM_CONTRACTOR_SMTP_SECU" default="none" showon="mailengine:2">
            <option value="COM_CONTRACTOR_SMTP_NONE">None</option>
            <option value="SSL">SSL</option>
            <option value="TLS">TLS</option>
        </field>
        
        <field name="smtp_auth" type="list" label="COM_CONTRACTOR_SMTP_AUTH" default="login" showon="mailengine:2">
            <option value="login">LOGIN</option>
            <option value="plain">PLAIN</option>
            <option value="cram-md5">CRAM-MD5</option>
        </field>
        
        <field name="smtp_username" type="text" label="COM_CONTRACTOR_SMTP_USER" showon="mailengine:2" />
        
        <field name="smtp_password" type="password" label="COM_CONTRACTOR_SMTP_PASS" showon="mailengine:2" />

        <field name="signature" type="editor" label="COM_CONTRACTOR_SIGNATURE" filter="Joomla\CMS\Component\ComponentHelper::filterText" buttons="false" />
    </fieldset>

    <fieldset name="frontend" addfieldprefix="XavierSpirlet\Component\Contractor\Administrator\Field">
        <field name="font_framework" type="Frameworkicon" label="COM_CONTRACTOR_CONFIGURATION_CSSFW" default="0" />
        
        <field name="front_loadfw" label="COM_CONTRACTOR_CONFIGURATION_CSSFORCE" type="radio" default="0" description="COM_CONTRACTOR_CONFIGURATION_CSSFORCEDESC" layout="joomla.form.field.radio.switcher">
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>
        <field name="front_color1" type="color" label="COM_CONTRACTOR_CONFIGURATION_COLC" default="#c7d1e1" />
        <field name="front_color2" type="color" label="COM_CONTRACTOR_CONFIGURATION_COLI" default="#c7d8a9" />
    </fieldset>
</form>