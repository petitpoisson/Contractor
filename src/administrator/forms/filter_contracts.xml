<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" inputmode="search" label="JSEARCH_FILTER" hint="COM_CONTRACTOR_CONTRACT_SEARCH" />
        
        <field name="published" type="list" label="JSTATUS" class="js-select-submit-on-change">
            <option value="">- Select Status -</option>
            <option value="1">Active</option>
            <option value="0">Inactive</option>
        </field>

        <field name="tag_id" type="sql" query="SELECT id, value FROM #__ctr_tags ORDER BY value ASC" key_field="id" value_field="value" header="- Select Tag -" label="Tag" class="js-select-submit-on-change" />

        <field name="client_id" type="sql" query="SELECT id, client_name FROM #__ctr_client ORDER BY client_name ASC" key_field="id" value_field="client_name" header="- All Clients -" label="Client" class="js-select-submit-on-change" />

    </fields>
    
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.valid_thru ASC" class="js-select-submit-on-change">
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.id ASC">COM_CONTRACTOR_SORT_IDASC</option>
            <option value="a.id DESC">COM_CONTRACTOR_SORT_IDDESC</option>
            <option value="a.published ASC">COM_CONTRACTOR_SORT_STASC</option>
            <option value="a.published DESC">COM_CONTRACTOR_SORT_STADEC</option>
            <option value="a.name ASC">COM_CONTRACTOR_SORT_NMASC</option>
            <option value="a.name DESC">COM_CONTRACTOR_SORT_NMDESC</option>
            <option value="c.client_name ASC">COM_CONTRACTOR_SORT_CLASC</option>
            <option value="c.client_name DESC">COM_CONTRACTOR_SORT_CLDESC</option>
            <option value="a.valid_thru ASC">COM_CONTRACTOR_SORT_VLASC</option>
            <option value="a.valid_thru DESC">COM_CONTRACTOR_SORT_VLDESC</option>
            <option value="t.value ASC">COM_CONTRACTOR_SORT_TAGASC</option>
            <option value="t.value DESC">COM_CONTRACTOR_SORT_TAGDESC</option>
            <option value="totprice ASC">COM_CONTRACTOR_SORT_VALASC</option>
            <option value="totprice DESC">COM_CONTRACTOR_SORT_VALDESC</option>
        </field>
        
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" class="js-select-submit-on-change" />
    </fields>
</form>