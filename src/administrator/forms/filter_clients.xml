<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="filter">
        <field name="search" type="text" inputmode="search" label="JSEARCH_FILTER" hint="COM_CONTRACTOR_CLIENT_SEARCH" />
        
        <field name="published" type="list" label="JSTATUS" class="js-select-submit-on-change">
            <option value="">- Select Status -</option>
            <option value="1">Active</option>
            <option value="0">Inactive</option>
        </field>

        <field name="tag_id" type="sql" query="SELECT id, value FROM #__ctr_tags ORDER BY value ASC" key_field="id" value_field="value" header="- Select Tag -" label="Tag" class="js-select-submit-on-change" />
    </fields>
    
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.client_name ASC" class="js-select-submit-on-change">
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="a.id ASC">COM_CONTRACTOR_SORT_IDASC</option>
            <option value="a.id DESC">COM_CONTRACTOR_SORT_IDDESC</option>
            <option value="a.published ASC">COM_CONTRACTOR_SORT_STASC</option>
            <option value="a.published DESC">COM_CONTRACTOR_SORT_STDESC</option>
            <option value="t.value ASC">COM_CONTRACTOR_SORT_TAGASC</option>
            <option value="t.value DESC">COM_CONTRACTOR_SORT_TAGDESC</option>
            <option value="a.client_name ASC">COM_CONTRACTOR_SORT_PASC</option>
            <option value="a.client_name DESC">COM_CONTRACTOR_SORT_PDESC</option>
            <option value="a.company_name ASC">COM_CONTRACTOR_SORT_CASC</option>
            <option value="a.company_name DESC">COM_CONTRACTOR_SORT_CDESC</option>
            <option value="a.email ASC">COM_CONTRACTOR_SORT_MAILASC</option>
            <option value="a.email DESC">COM_CONTRACTOR_SORT_MAILDESC</option>
            <option value="nbcontract ASC">COM_CONTRACTOR_SORT_CONTASC</option>
            <option value="nbcontract DESC">COM_CONTRACTOR_SORT_CONTDESC</option>
            <option value="nbinvoices ASC">COM_CONTRACTOR_SORT_INVASC</option>
            <option value="nbinvoices DESC">COM_CONTRACTOR_SORT_INVDESC</option>
        </field>
        
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" class="js-select-submit-on-change" />
    </fields>
</form>